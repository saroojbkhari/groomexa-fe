# Copy to .env and fill in. NEXT_PUBLIC_* values are exposed to the browser — never put secrets in them.

# Public site URL, used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Groomexa backend API. The browser calls it directly (no cookies; tokens go in the Authorization header).
# The backend's CORS allows exactly this app's origin, and its APP_URL must point here (http://localhost:3001)
# so email links land on /verify-email and /reset-password.
NEXT_PUBLIC_API_URL=http://localhost:3000
